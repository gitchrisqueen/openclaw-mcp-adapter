{
  "name": "openclaw-mcp-adapter",
  "version": "0.1.1",
  "type": "module",
  "description": "OpenClaw plugin that exposes MCP server tools as native agent tools",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "index.ts",
    "mcp-client.ts",
    "config.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/androidStern/openclaw-mcp-adapter"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "scripts": {
    "build": "bun build ./index.ts --outfile ./dist/index.js --format esm --target node"
  }
}
